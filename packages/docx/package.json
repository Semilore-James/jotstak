{
  "name": "@jotstak/docx",
  "version": "0.0.0",
  "description": "A .jot document as a Word file (.docx). No dependencies beyond the renderer: the file is written by hand, so it runs in a browser and in Node alike.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@jotstak/renderer": "*"
  },
  "devDependencies": {
    "@jotstak/schema": "*",
    "fontkit": "^2.0.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
