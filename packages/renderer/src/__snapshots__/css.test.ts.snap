  --jot-shape-elevation-card: 2px 2px 0px #e4d5be;
  --jot-shape-elevation-card-fact: 2px 2px 0px #d27b42;
  --jot-shape-elevation-doc-sheet: 0 1px 3px 0 rgba(0,0,0,0.04), 0 1px 2px -1px rgba(0,0,0,0.02);
  --jot-shape-elevation-modal: 0 12px 24px -4px rgba(0,0,0,0.35);
  --jot-shape-connectors-width: 1.5px;
  --jot-shape-connectors-color: #436475;
  --jot-shape-connectors-dash-array: 3,3;
  --jot-shape-connectors-junction-dot: 2.5px;
  --jot-shape-connectors-corner-fillet: 4px;
  --jot-layout-main-column-ratio: 0.77;
  --jot-layout-margin-channel-ratio: 0.23;
  --jot-layout-max-content-width: 880px;
  --jot-layout-left-margin-line-x: 32px;
