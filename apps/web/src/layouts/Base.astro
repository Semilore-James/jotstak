---
// The one place the renderer's design system enters the website.
//
// renderThemeCss() and renderLayoutCss() are generated by @jotstak/renderer from
// the same tokens the extension preview uses, so the site and the tool cannot
// drift apart. Injecting them here rather than per-page means a new page gets
// the system by existing.
import { renderThemeCss, renderLayoutCss } from "@jotstak/renderer";

interface Props {
  title: string;
  description: string;
  /** Page-specific CSS, appended after the design system. */
  extraCss?: string;
}

const { title, description, extraCss = "" } = Astro.props;
const site = "https://jotstak.pages.dev";

// assetBase "" resolves fonts to /fonts/<file>, which is where copy-fonts.mjs
// puts them. Without it no @font-face rules are emitted at all.
const themeCss = renderThemeCss({ assetBase: "" });
const layoutCss = renderLayoutCss();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#c67139" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}/og.png`} />

    <style is:inline set:html={themeCss}></style>
    <style is:inline set:html={layoutCss}></style>
    <style is:inline set:html={extraCss}></style>
  </head>
  <body class="jotstak" data-mode="notebook">
    <header class="site-head">
      <a class="site-brand" href="/">
        <img src="/lockup.svg" alt="Jotstak" width="176" height="25" />
      </a>
      <nav class="site-nav">
        <a href="/playground">Playground</a>
        <a href="/docs">Docs</a>
        <a href="https://github.com/Semilore-James/jotstak" rel="noopener">GitHub</a>
      </nav>
    </header>

    <slot />

    <footer class="site-foot">
      <p>
        Jotstak is free and open source under the{" "}
        <a href="https://github.com/Semilore-James/jotstak/blob/main/LICENSE">MIT licence</a>.
        {" "}Built by <a href="https://github.com/Semilore-James">Semilore-James</a>.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* Chrome around the rendered document. Scoped to the site shell, never to
     .jot-* elements, so the renderer's own styling stays authoritative. */
  body.jotstak {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 28px 28px 0;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }
  .site-brand { display: inline-flex; line-height: 0; }
  .site-brand img { height: 25px; width: auto; }

  .site-nav {
    display: flex;
    gap: 22px;
    font-family: var(--jot-font-label);
    font-size: 13px;
    letter-spacing: 0.02em;
  }
  .site-nav a {
    color: var(--jot-ink-muted);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }
  .site-nav a:hover {
    color: var(--jot-ink);
    border-bottom-color: var(--jot-accent);
  }

  .site-foot {
    margin-top: auto;
    padding: 28px;
    max-width: 1180px;
    margin-inline: auto;
    width: 100%;
    box-sizing: border-box;
    font-family: var(--jot-font-label);
    font-size: 12px;
    color: var(--jot-ink-muted);
  }
  .site-foot a { color: var(--jot-ink-muted); }

  @media (max-width: 600px) {
    .site-head { flex-direction: column; align-items: flex-start; gap: 14px; }
  }
</style>
