---
// Landing page. The hero renders a real .jot document with the real renderer at
// build time — the page is its own proof. Nothing here is a mockup.
import Base from "../layouts/Base.astro";
import { render, PAGE } from "@jotstak/renderer";

// A whole sheet of A4 at 96dpi: the printable width plus the page margins.
const SHEET = PAGE.portrait.content + 2 * PAGE.marginX;

const source = `# Q3 pricing review

Three tools, one decision. Everything lives here.

>> ask Ana before Friday

- Usage-based beat seat-based in 4 of 5 interviews
- Finance needs 30 days' notice to change billing

@decision title="Move to usage-based pricing" status=accepted
  context: Seat pricing punishes the teams who adopt fastest
  choice: Usage-based, billed monthly, with a floor
  consequences: Revenue is lumpier; forecasting needs rework
`;

const { html } = render(source, { mode: "notebook" });

const extraCss = `
.hero { max-width: 1180px; margin: 0 auto; padding: 56px 28px 28px; }
.hero h1 {
  font-family: var(--jot-font-heading);
  font-size: clamp(32px, 5vw, 52px);
  line-height: 1.12;
  letter-spacing: -0.02em;
  margin: 0 0 20px;
  max-width: 16ch;
}
.hero .lede {
  font-family: var(--jot-font-body);
  font-size: 19px;
  line-height: 30px;
  color: var(--jot-ink-muted);
  max-width: 58ch;
  margin: 0 0 12px;
}
.hero .ladder { font-size: 16px; max-width: 58ch; margin: 0 0 28px; }
.hero .ladder code {
  font-family: var(--jot-font-mono);
  font-size: 14px;
  background: var(--jot-surface-elevated);
  border-radius: 2px;
  padding: 1px 5px;
}
.cta { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 8px; }
.cta a {
  font-family: var(--jot-font-label);
  font-size: 14px;
  text-decoration: none;
  padding: 11px 20px;
  border-radius: 4px;
  border: 1px solid var(--jot-accent);
}
.cta .primary { background: var(--jot-accent); color: var(--jot-color-notebook-paper); box-shadow: 2px 2px 0 var(--jot-color-notebook-rule-lines); }
.cta .secondary { color: var(--jot-accent); }
.cta a:hover { transform: translate(-1px, -1px); }

/* Wider than the hero above it, and by a measured amount: at 1400 the right
   column is a sheet of A4 at its true size, so "you get" is literally the page
   you would print, not a scaled picture of one. */
.showcase { max-width: 1400px; margin: 0 auto; padding: 0 28px 56px; }
.showcase-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 28px; align-items: start; }
.pane-label {
  font-family: var(--jot-font-label);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--jot-ink-muted);
  margin: 0 0 10px;
}
.source {
  font-family: var(--jot-font-mono);
  font-size: 13px;
  line-height: 22px;
  white-space: pre-wrap;
  margin: 0;
  padding: 18px 20px;
  background: var(--jot-color-notebook-paper-elevated);
  border: 1px solid var(--jot-color-notebook-rule-lines);
  border-radius: 4px;
  overflow-wrap: anywhere;
}
.source .d { color: var(--jot-color-syntax-directive); font-weight: 500; }
.source .m { color: var(--jot-color-syntax-marginalia); }
.source .s { color: var(--jot-color-syntax-structural); }

.rendered {
  background: var(--jot-color-notebook-paper);
  border: 1px solid var(--jot-color-notebook-rule-lines);
  border-radius: 4px;
  box-shadow: 2px 2px 0 var(--jot-color-notebook-rule-lines);
  container-type: inline-size;
}
/* A real sheet, zoomed to fit the column and never past 1:1 (ARC-14) — the
   same fit the playground and the docs demos use. It used to fold the margin
   channel under its anchor for want of room; the channel is where a note goes,
   and a landing page that hides it is selling something else. */
.rendered > .jotstak { zoom: min(1, calc(100cqw / ${SHEET}px)); }
.rendered .jot-doc { padding-inline: ${PAGE.marginX}px; }

@media (max-width: 860px) {
  .showcase-grid { grid-template-columns: 1fr; }
}
`;

// Minimal highlighting for the source pane so .jot reads as a language.
const highlighted = source
  .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
  .replace(/^(@[a-z_]+.*)$/gm, '<span class="d">$1</span>')
  .replace(/^(&gt;&gt; .*)$/gm, '<span class="m">$1</span>')
  .replace(/^(#{1,3} .*)$/gm, '<span class="s">$1</span>');
---

<Base
  title="Jotstak — one file. Prose, tables and diagrams."
  description="Stop scattering a single PRD across Docs, Sheets and Miro. Write it in .jot — prose, tables and diagrams in one plain-text file, rendered as a warm, hand-kept notebook."
  extraCss={extraCss}
>
  <main>
    <section class="hero">
      <h1>One file. Prose, tables and diagrams.</h1>
      <p class="lede">
        Writing one PRD usually means five tools — Docs for prose, Sheets for tables,
        Miro for diagrams, Notion as the hub. Context gets lost on the seams, versions
        drift, and nobody joining later can reconstruct where anything lives.
      </p>
      <p class="ladder">
        Jotstak keeps all of it in one plain-text file and renders it as a notebook
        worth re-reading. <code>.jot</code> is a superset of Markdown, so any
        <code>.md</code> file works unchanged — there is nothing to learn before you start.
      </p>
      <div class="cta">
        <a class="primary" href="/playground">Try it in your browser</a>
        <a class="secondary" href="/docs">Read the docs</a>
      </div>
    </section>

    <section class="showcase">
      <div class="showcase-grid">
        <div>
          <p class="pane-label">You write</p>
          <pre class="source" set:html={highlighted}></pre>
        </div>
        <div>
          <p class="pane-label">You get</p>
          <div class="rendered" set:html={html}></div>
        </div>
      </div>
    </section>
  </main>
</Base>
