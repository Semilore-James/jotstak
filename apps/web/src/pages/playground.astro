---
// The playground. Type .jot on the left, see it render on the right.
//
// It imports the SAME @jotstak/renderer the extension preview uses, and runs it
// entirely in the browser. No API call, nothing uploaded, no backend to pay for.
// That is the local-first architecture paying off twice: it is the reason the
// tool works offline, and the reason this page costs nothing to host.
import Base from "../layouts/Base.astro";

const starter = `@meta
  project: Pricing v2
  owner: Marta
  status: in review
  updated: 2026-09-19

# Moving to usage-based pricing

@risk(level=high title="Churn among small teams")
  Small teams pay less under usage pricing, but they are also the loudest
  segment and the first to post about a change.
  mitigation: Grandfather existing plans for 12 months.

>> this is the one that worries me

@metric(name="Weekly active teams" value="1,240" target="2,000" trend=up status=on-track)
  Growing 8% week-over-week since the playground shipped.

@evidence(by="User P7" source="Discovery interview 3" tag=pricing)
  We stopped adding people to the workspace because every new seat cost money.
  That is exactly backwards from what you want us doing.

@decision(
  title="Usage-based, billed monthly, with a floor"
  status=accepted
  date=2026-09-19
)
  context: Seat pricing punishes the teams who adopt fastest
  choice: Usage-based with a floor so revenue stays predictable
  consequences: Revenue is lumpier; forecasting needs rework

@warn
  Finance needs 30 days' notice before any billing change ships.

@assumption(title="Teams will accept a floor" confidence=medium)
  Teams tolerate a minimum charge if it is visibly lower than their current bill.
  validation: Offer it to 5 accounts at renewal; 3 of 5 accept without escalation.

@persona(name="Marta, the systems PM")
  role: Platform PM at a mid-size fintech
  goal: Sketch the pricing model inside the spec, not in a separate tool
  frustration: The diagram lives in Miro and the numbers live in Sheets
`;

const extraCss = `
.pg { max-width: 1400px; margin: 0 auto; padding: 20px 28px 40px; width: 100%; box-sizing: border-box; }
.pg-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
.pg-bar h1 { font-family: var(--jot-font-heading); font-size: 22px; margin: 0; font-weight: 600; }
.pg-tools { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.pg-tools label { font-family: var(--jot-font-label); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--jot-ink-muted); }
.pg-tools select, .pg-tools button {
  font-family: var(--jot-font-label); font-size: 13px;
  padding: 7px 12px; border-radius: 4px;
  border: 1px solid var(--jot-color-notebook-rule-lines);
  background: var(--jot-color-notebook-paper); color: var(--jot-color-notebook-ink);
  cursor: pointer;
}
.pg-tools button[aria-pressed="true"] { background: var(--jot-accent); color: var(--jot-color-notebook-paper); border-color: var(--jot-accent); }

.pg-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.15fr); gap: 20px; align-items: stretch; }
.pane { display: flex; flex-direction: column; min-height: 68vh; }
.pane-label { font-family: var(--jot-font-label); font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--jot-ink-muted); margin: 0 0 8px; }

#src {
  flex: 1; width: 100%; box-sizing: border-box; resize: none;
  font-family: var(--jot-font-mono); font-size: 13.5px; line-height: 22px;
  padding: 18px 20px; tab-size: 2;
  background: var(--jot-color-notebook-paper-elevated);
  color: var(--jot-color-notebook-ink);
  border: 1px solid var(--jot-color-notebook-rule-lines); border-radius: 4px;
}
#src:focus { outline: 2px solid var(--jot-accent); outline-offset: -1px; }

#out-wrap {
  flex: 1; overflow: auto; border-radius: 4px;
  border: 1px solid var(--jot-color-notebook-rule-lines);
  box-shadow: 2px 2px 0 var(--jot-color-notebook-rule-lines);
}
#out { min-height: 100%; }
#out .jot-doc { padding: 14px 24px; max-width: none; }

#diags { margin-top: 10px; font-family: var(--jot-font-mono); font-size: 12px; line-height: 20px; }
#diags:empty { display: none; }
#diags .d { padding: 4px 10px; border-radius: 3px; margin-bottom: 4px; }
#diags .error   { background: #fdecea; color: #8c1d18; border-left: 2px solid #b3261e; }
#diags .warning { background: #fff4e5; color: #7a4b00; border-left: 2px solid #c67139; }
#diags .info    { background: #eef2f5; color: #3d5666; border-left: 2px solid #436475; }

@media (max-width: 900px) {
  .pg-grid { grid-template-columns: 1fr; }
  .pane { min-height: 46vh; }
}
`;
---

<Base
  title="Jotstak playground — write .jot, see it render"
  description="Type .jot in your browser and watch it render as a notebook. Nothing is uploaded; the renderer runs entirely on your machine."
  extraCss={extraCss}
>
  <main class="pg">
    <div class="pg-bar">
      <h1>Playground</h1>
      <div class="pg-tools">
        <label for="sample">Sample</label>
        <select id="sample">
          <option value="starter">A real PM document</option>
          <option value="markdown">Plain Markdown (no .jot at all)</option>
          <option value="empty">Empty</option>
        </select>
        <label>Mode</label>
        <button id="m-notebook" aria-pressed="true">Notebook</button>
        <button id="m-doc" aria-pressed="false">Doc</button>
      </div>
    </div>

    <div class="pg-grid">
      <section class="pane">
        <p class="pane-label">Source</p>
        <textarea id="src" spellcheck="false" aria-label="Jotstak source">{starter}</textarea>
        <div id="diags" role="status" aria-live="polite"></div>
      </section>
      <section class="pane">
        <p class="pane-label">Rendered</p>
        <div id="out-wrap"><div id="out"></div></div>
      </section>
    </div>
  </main>
</Base>

<script>
  import { render } from "@jotstak/renderer";

  const SAMPLES: Record<string, string> = {
    starter: "",
    markdown: [
      "# A plain Markdown file",
      "",
      "This document contains **no Jotstak syntax at all** — it is ordinary",
      "Markdown, and it renders unchanged. That is the whole on-ramp.",
      "",
      "- Nested lists work",
      "  - like this",
      "1. So do numbered ones",
      "",
      "> And block quotes.",
      "",
      "```js",
      "// fenced code is left alone",
      "const x = 1;",
      "```",
      "",
      "| Tool | Used for |",
      "| --- | --- |",
      "| Docs | Prose |",
      "| Miro | Diagrams |",
    ].join("\n"),
    empty: "",
  };

  const src = document.querySelector<HTMLTextAreaElement>("#src");
  const out = document.querySelector<HTMLDivElement>("#out");
  const diags = document.querySelector<HTMLDivElement>("#diags");
  const picker = document.querySelector<HTMLSelectElement>("#sample");
  const nbBtn = document.querySelector<HTMLButtonElement>("#m-notebook");
  const docBtn = document.querySelector<HTMLButtonElement>("#m-doc");

  if (src && out && diags && picker && nbBtn && docBtn) {
    SAMPLES.starter = src.value;
    let mode: "notebook" | "doc" = "notebook";

    const paint = (): void => {
      const { html, diagnostics } = render(src.value, { mode });
      out.innerHTML = html;
      diags.innerHTML = diagnostics
        .map((d) => {
          const text = `${d.severity} · line ${d.line + 1} — ${d.message}`;
          const esc = text.replace(/&/g, "&amp;").replace(/</g, "&lt;");
          return `<div class="d ${d.severity}">${esc}</div>`;
        })
        .join("");
    };

    const setMode = (next: "notebook" | "doc"): void => {
      mode = next;
      nbBtn.setAttribute("aria-pressed", String(next === "notebook"));
      docBtn.setAttribute("aria-pressed", String(next === "doc"));
      paint();
    };

    src.addEventListener("input", paint);
    picker.addEventListener("change", () => {
      src.value = SAMPLES[picker.value] ?? "";
      paint();
    });
    nbBtn.addEventListener("click", () => setMode("notebook"));
    docBtn.addEventListener("click", () => setMode("doc"));

    paint();
  }
</script>
