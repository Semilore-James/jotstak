---
// The playground. Type .jot on the left, see it render on the right.
//
// It imports the SAME @jotstak/renderer the extension preview uses, and runs it
// entirely in the browser. No API call, nothing uploaded, no backend to pay for.
// That is the local-first architecture paying off twice: it is the reason the
// tool works offline, and the reason this page costs nothing to host.
import Base from "../layouts/Base.astro";
import { PAGE, renderPageCss } from "@jotstak/renderer";

// A whole sheet of A4 at 96dpi: the printable width plus the page margins.
const SHEET = PAGE.portrait.content + 2 * PAGE.marginX;
// The starter document is a real file in samples/, not a string literal here.
// It used to be inline, and it silently rotted: it still said @evidence long
// after the recut folded that into @quote, so the playground greeted everyone
// with a red error. In samples/ it is covered by the same test as every other
// document, and a cut primitive now fails the build instead of the first visitor.
//
// `?raw` and not readFileSync: Vite resolves it against THIS file and inlines
// the text, whereas import.meta.url at build time points at the bundled chunk
// in dist/.prerender/chunks, which sent the path off into apps/samples.
import starter from "../../../../samples/pricing-v2.jot?raw";

const extraCss = `
/* Wider than the rest of the site, and the width is not arbitrary: at 1500 a
   desktop pane is just past a sheet of A4, so the paper shows at 1:1 instead
   of being zoomed down. */
.pg { max-width: 1500px; margin: 0 auto; padding: 20px 28px 40px; width: 100%; box-sizing: border-box; }
.pg-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
.pg-bar h1 { font-family: var(--jot-font-heading); font-size: 22px; margin: 0; font-weight: 600; }
.pg-tools { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.pg-tools > span {
  font-family: var(--jot-font-label); font-size: 10px; font-weight: 600;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--jot-ink-muted);
}

/* Segmented control rather than two loose buttons. The moving indicator is a
   single element that slides, so the label text never re-renders mid-transition
   and there is no flicker. */
.seg {
  position: relative; display: inline-flex; padding: 3px; border-radius: 6px;
  background: var(--jot-color-notebook-paper-elevated);
  border: 1px solid var(--jot-color-notebook-rule-lines);
}
.seg-thumb {
  position: absolute; top: 3px; bottom: 3px; left: 3px;
  border-radius: 4px; background: var(--jot-accent);
  transition: transform 220ms cubic-bezier(.22,.61,.36,1), width 220ms cubic-bezier(.22,.61,.36,1);
  pointer-events: none;
}
.seg button {
  position: relative; z-index: 1; border: 0; background: none; cursor: pointer;
  font-family: var(--jot-font-label); font-size: 13px; padding: 6px 14px;
  color: var(--jot-ink-muted); border-radius: 4px;
  transition: color 160ms ease;
}
.seg button[aria-pressed="true"] { color: var(--jot-color-notebook-paper); }
.seg button:focus-visible { outline: 2px solid var(--jot-accent); outline-offset: 2px; }

/* Custom select: a native one cannot be styled consistently across platforms,
   and its default chrome is the single most off-brand thing on the page. */
.picker { position: relative; }
.picker-btn {
  display: inline-flex; align-items: center; gap: 10px;
  font-family: var(--jot-font-label); font-size: 13px;
  padding: 7px 12px; border-radius: 6px; cursor: pointer;
  border: 1px solid var(--jot-color-notebook-rule-lines);
  background: var(--jot-color-notebook-paper);
  color: var(--jot-color-notebook-ink);
  transition: border-color 160ms ease, box-shadow 160ms ease;
}
.picker-btn:hover { border-color: var(--jot-accent); }
.picker-btn:focus-visible { outline: 2px solid var(--jot-accent); outline-offset: 2px; }
.picker-btn svg { transition: transform 200ms cubic-bezier(.22,.61,.36,1); }
.picker[data-open="true"] .picker-btn svg { transform: rotate(180deg); }

.picker-menu {
  position: absolute; top: calc(100% + 6px); right: 0; z-index: 20;
  min-width: 230px; padding: 4px; margin: 0; list-style: none;
  border-radius: 8px;
  border: 1px solid var(--jot-color-notebook-rule-lines);
  background: var(--jot-color-notebook-paper);
  box-shadow: 0 10px 24px -8px rgba(44,37,35,.28);
  opacity: 0; transform: translateY(-6px) scale(.98); transform-origin: top right;
  pointer-events: none;
  transition: opacity 160ms ease, transform 200ms cubic-bezier(.22,.61,.36,1);
}
.picker[data-open="true"] .picker-menu { opacity: 1; transform: none; pointer-events: auto; }
.picker-menu button {
  display: block; width: 100%; text-align: left; border: 0; background: none;
  font-family: var(--jot-font-label); font-size: 13px; line-height: 20px;
  padding: 8px 10px; border-radius: 5px; cursor: pointer;
  color: var(--jot-color-notebook-ink);
}
.picker-menu button small { display: block; color: var(--jot-ink-muted); font-size: 11px; }
.picker-menu button:hover { background: var(--jot-color-notebook-paper-elevated); }
.picker-menu button[aria-selected="true"] { color: var(--jot-accent); }

@media (prefers-reduced-motion: reduce) {
  .seg-thumb, .picker-btn svg, .picker-menu { transition: none; }
}

.pg-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.3fr); gap: 20px; align-items: start; }
.pane { display: flex; flex-direction: column; min-width: 0; }
/* The source stays within reach while the paper scrolls past it. The window
   does the scrolling — the document is not trapped in a box of its own. */
.pane-src { position: sticky; top: 18px; height: calc(100vh - 36px); }
.pane-label { font-family: var(--jot-font-label); font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--jot-ink-muted); margin: 0 0 8px; }

#src {
  flex: 1; width: 100%; box-sizing: border-box; resize: none;
  font-family: var(--jot-font-mono); font-size: 13.5px; line-height: 22px;
  padding: 18px 20px; tab-size: 2;
  background: var(--jot-color-notebook-paper-elevated);
  color: var(--jot-color-notebook-ink);
  border: 1px solid var(--jot-color-notebook-rule-lines); border-radius: 4px;
}
#src:focus { outline: 2px solid var(--jot-accent); outline-offset: -1px; }

/* The rendered side is a sheet of A4, not a scrolling box.
   It used to be an overflow:auto frame with the document squeezed to whatever
   width the pane happened to be. Two things were wrong with that. The document
   on screen was a different width from the one that prints, so a figure could
   look settled here and escalate on paper. And a long document scrolled
   inside a frame — a box of paper inside a page — when the page itself is
   the thing that should scroll (ARC-14: print-true pages, continuous screen).
   So the sheet keeps its real A4 width and is zoomed down to fit the pane,
   the way a print preview does. Zoom rather than transform: scale, because
   zoom reflows: the sheet's box really is smaller, so it takes the right
   amount of room and the wrapper needs no height correction. It never zooms
   past 1 — paper is not magnified, only fitted. */
#out-wrap {
  container-type: inline-size;
  border-radius: 4px;
  border: 1px solid var(--jot-color-notebook-rule-lines);
  box-shadow: 2px 2px 0 var(--jot-color-notebook-rule-lines);
}
#out { zoom: min(1, calc(100cqw / ${SHEET}px)); }
/* The side margins are the page's real ones, so the sheet is exactly A4 wide
   (ARC-14). Doc mode already sets these; notebook mode had 24px of padding
   chosen by eye. */
#out .jot-doc { padding-inline: ${PAGE.marginX}px; }

#diags { margin-top: 10px; font-family: var(--jot-font-mono); font-size: 12px; line-height: 20px; }
#diags:empty { display: none; }
#diags .d { padding: 4px 10px; border-radius: 3px; margin-bottom: 4px; }
#diags .error   { background: #fdecea; color: #8c1d18; border-left: 2px solid #b3261e; }
#diags .warning { background: #fff4e5; color: #7a4b00; border-left: 2px solid #c67139; }
#diags .info    { background: #eef2f5; color: #3d5666; border-left: 2px solid #436475; }

@media (max-width: 900px) {
  .pg-grid { grid-template-columns: 1fr; }
  /* Stacked, there is nothing to stay beside: the editor scrolls away like
     everything else, and takes a fixed slice of the viewport instead. */
  .pane-src { position: static; height: auto; }
  #src { min-height: 46vh; }
}

/* Printing the playground prints the DOCUMENT, on real A4 pages — not the
   editor around it. This is the one place today where a .jot file becomes a
   PDF, until the extension's export arrives. */
@media print {
  .site-head, .site-foot, .pg-bar, .pg-grid > .pane:first-child, .pane-label, #diags { display: none !important; }
  body { margin: 0; }
  .pg { padding: 0; max-width: none; }
  .pg-grid { display: block; }
  .pane { min-height: 0; }
  /* The sheet is the paper now, so it prints at 1:1 with no frame around it
     and no containment — a size container would fragment its own way across
     pages, and pagination here has to stay the browser's job. */
  #out-wrap { border: 0; box-shadow: none; container-type: normal; }
  #out { zoom: 1; }
  #out .jot-doc { padding: 0; }
}
${renderPageCss()}
`;
---

<Base
  title="Jotstak playground — write .jot, see it render"
  description="Type .jot in your browser and watch it render as a notebook. Nothing is uploaded; the renderer runs entirely on your machine."
  extraCss={extraCss}
>
  <main class="pg">
    <div class="pg-bar">
      <h1>Playground</h1>
      <div class="pg-tools">
        <span>Sample</span>
        <div class="picker" id="picker" data-open="false">
          <button class="picker-btn" id="picker-btn" aria-haspopup="listbox" aria-expanded="false">
            <span id="picker-label">A real PM document</span>
            <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
              <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </button>
          <ul class="picker-menu" id="picker-menu" role="listbox">
            <li><button role="option" data-value="starter" aria-selected="true">A real PM document<small>Seven primitives, composed</small></button></li>
            <li><button role="option" data-value="markdown" aria-selected="false">Plain Markdown<small>No .jot syntax at all</small></button></li>
            <li><button role="option" data-value="nested" aria-selected="false">Nested blocks<small>A metric inside a decision</small></button></li>
            <li><button role="option" data-value="diagram" aria-selected="false">Diagrams<small>A tree, from indentation alone</small></button></li>
            <li><button role="option" data-value="empty" aria-selected="false">Empty<small>Start from nothing</small></button></li>
          </ul>
        </div>

        <span>Mode</span>
        <div class="seg" id="seg">
          <span class="seg-thumb" id="seg-thumb"></span>
          <button id="m-notebook" aria-pressed="true">Notebook</button>
          <button id="m-doc" aria-pressed="false">Doc</button>
        </div>
      </div>
    </div>

    <div class="pg-grid">
      <section class="pane pane-src">
        <p class="pane-label">Source</p>
        <textarea id="src" spellcheck="false" aria-label="Jotstak source">{starter}</textarea>
        <div id="diags" role="status" aria-live="polite"></div>
      </section>
      <section class="pane">
        <p class="pane-label">Rendered</p>
        <div id="out-wrap"><div id="out"></div></div>
      </section>
    </div>
  </main>
</Base>

<script>
  import { render } from "@jotstak/renderer";

  const SAMPLES: Record<string, string> = {
    starter: "",
    markdown: [
      "# A plain Markdown file",
      "",
      "This document contains **no Jotstak syntax at all** — it is ordinary",
      "Markdown, and it renders unchanged. That is the whole on-ramp.",
      "",
      "- Nested lists work",
      "  - like this",
      "1. So do numbered ones",
      "",
      "> And block quotes.",
      "",
      "```js",
      "// fenced code is left alone",
      "const x = 1;",
      "```",
      "",
      "| Tool | Used for |",
      "| --- | --- |",
      "| Docs | Prose |",
      "| Miro | Diagrams |",
    ].join("\n"),
    nested: [
      "# Blocks compose",
      "",
      "Indent a block inside another and it nests. Nothing is a special case:",
      "a metric, a quote or a table can live inside any container.",
      "",
      "@decision(title=\"Move to usage-based pricing\" status=accepted)",
      "  context: Seat pricing punishes the teams who adopt fastest",
      "",
      "  @metric(name=\"Weekly active teams\" value=\"1,240\" target=\"2,000\" trend=up)",
      "    Growing 8% week-over-week.",
      "",
      "  @quote(by=\"User P7\" source=\"Interview 3\")",
      "    We stopped adding people because every new seat cost money.",
    ].join("\n"),
    diagram: [
      "# Diagrams from indentation",
      "",
      "A tree is indented lines — no canvas, no drag, no export step. It lives",
      "in the file beside the prose that argues for it.",
      "",
      "@tree dir=right",
      "  Discovery",
      "    Interviews",
      "      Synthesis",
      "    Survey",
      "",
      "Add `nodes=boxed` and the same lines carry more weight:",
      "",
      "@tree(dir=right nodes=boxed)",
      "  Discovery",
      "    Interviews",
      "      Synthesis",
      "    Survey",
      "",
      "Under `dir=split` it balances itself around the centre — branches are",
      "weighted by how much hangs off them, so you do not arrange anything.",
      "",
      "@tree(dir=split nodes=boxed)",
      "  Retention",
      "    Onboarding",
      "      First value",
      "    Habit loop",
      "    Reactivation",
      "    Win-back",
      "",
      ">> Prefix a node with `>` or `<` to pin which side it takes.",
    ].join("\n"),
    empty: "",
  };

  const $ = <T extends HTMLElement>(sel: string): T | null => document.querySelector<T>(sel);

  const src = $<HTMLTextAreaElement>("#src");
  const out = $<HTMLDivElement>("#out");
  const diags = $<HTMLDivElement>("#diags");
  const picker = $<HTMLDivElement>("#picker");
  const pickerBtn = $<HTMLButtonElement>("#picker-btn");
  const pickerLabel = $<HTMLSpanElement>("#picker-label");
  const pickerMenu = $<HTMLUListElement>("#picker-menu");
  const seg = $<HTMLDivElement>("#seg");
  const thumb = $<HTMLSpanElement>("#seg-thumb");
  const nbBtn = $<HTMLButtonElement>("#m-notebook");
  const docBtn = $<HTMLButtonElement>("#m-doc");

  if (src && out && diags && picker && pickerBtn && pickerLabel && pickerMenu && seg && thumb && nbBtn && docBtn) {
    SAMPLES.starter = src.value;
    let mode: "notebook" | "doc" = "notebook";

    const paint = (): void => {
      const { html, diagnostics } = render(src.value, { mode });
      out.innerHTML = html;
      diags.innerHTML = diagnostics
        .map((d) => {
          const text = `${d.severity} · line ${d.line + 1} — ${d.message}`;
          return `<div class="d ${d.severity}">${text.replace(/&/g, "&amp;").replace(/</g, "&lt;")}</div>`;
        })
        .join("");
    };

    // The sliding indicator is positioned from the real button geometry, so it
    // stays correct when the labels wrap or the font loads late.
    const moveThumb = (): void => {
      const active = mode === "notebook" ? nbBtn : docBtn;
      thumb.style.width = `${active.offsetWidth}px`;
      thumb.style.transform = `translateX(${active.offsetLeft - nbBtn.offsetLeft}px)`;
    };

    const setMode = (next: "notebook" | "doc"): void => {
      mode = next;
      nbBtn.setAttribute("aria-pressed", String(next === "notebook"));
      docBtn.setAttribute("aria-pressed", String(next === "doc"));
      moveThumb();
      paint();
    };

    const setOpen = (open: boolean): void => {
      picker.dataset.open = String(open);
      pickerBtn.setAttribute("aria-expanded", String(open));
    };

    pickerBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(picker.dataset.open !== "true");
    });
    document.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
    pickerMenu.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[role=option]");
      if (!btn) return;
      for (const o of pickerMenu.querySelectorAll("button[role=option]")) {
        o.setAttribute("aria-selected", String(o === btn));
      }
      pickerLabel.textContent = btn.childNodes[0]?.textContent?.trim() ?? "";
      src.value = SAMPLES[btn.dataset.value ?? "empty"] ?? "";
      setOpen(false);
      paint();
    });

    // Indentation decides structure in .jot, so the editor has to help with it.
    // Left to a bare textarea, Enter returns to column zero and Tab leaves the
    // field entirely — which is how a branch ends up one space out of line and
    // silently becomes a child of its sibling. The parser now reports that, but
    // not making the mistake beats being told about it.
    const STEP = 2;
    const leadingSpace = (line: string): string => (/^[ \t]*/.exec(line) ?? [""])[0];

    /** Replace the current selection, keeping undo history intact where possible. */
    const replaceSelection = (text: string, caretOffset?: number): void => {
      const start = src.selectionStart;
      if (!document.execCommand?.("insertText", false, text)) {
        const end = src.selectionEnd;
        src.value = src.value.slice(0, start) + text + src.value.slice(end);
      }
      if (caretOffset !== undefined) {
        const pos = start + caretOffset;
        src.setSelectionRange(pos, pos);
      }
      paint();
    };

    /** Indent or outdent every line the selection touches, by whole steps. */
    const shiftLines = (by: number): void => {
      const value = src.value;
      const from = value.lastIndexOf("\n", src.selectionStart - 1) + 1;
      const toEnd = value.indexOf("\n", src.selectionEnd);
      const to = toEnd === -1 ? value.length : toEnd;
      const shifted = value
        .slice(from, to)
        .split("\n")
        .map((line) => {
          if (by > 0) return " ".repeat(STEP) + line;
          const lead = leadingSpace(line);
          return line.slice(Math.min(STEP, lead.length));
        })
        .join("\n");

      src.setSelectionRange(from, to);
      replaceSelection(shifted);
      src.setSelectionRange(from, from + shifted.length);
      paint();
    };

    // Escape releases the field so Tab can still move focus — trapping Tab
    // outright would make the editor unreachable by keyboard.
    let tabMovesFocus = false;
    src.addEventListener("blur", () => { tabMovesFocus = false; });

    src.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape") { tabMovesFocus = true; return; }
      if (e.key !== "Tab" && e.key !== "Enter") tabMovesFocus = false;

      if (e.key === "Tab" && !tabMovesFocus) {
        e.preventDefault();
        if (e.shiftKey || src.selectionStart !== src.selectionEnd) shiftLines(e.shiftKey ? -1 : 1);
        else replaceSelection(" ".repeat(STEP), STEP);
        return;
      }

      if (e.key === "Enter" && !e.shiftKey && src.selectionStart === src.selectionEnd) {
        const upTo = src.value.slice(0, src.selectionStart);
        const line = upTo.slice(upTo.lastIndexOf("\n") + 1);
        let indent = leadingSpace(line);
        // A directive or a `key:` opens a body, so the next line belongs inside
        // it. This is the one place guessing is safe: it is what the author
        // meant every time, and one Shift+Tab undoes it.
        if (line.trim() !== "" && /^\s*(@[a-zA-Z_]|[^:]+:\s*$)/.test(line) && !/\)\s*$/.test(line)) {
          indent += " ".repeat(STEP);
        }
        e.preventDefault();
        replaceSelection("\n" + indent, 1 + indent.length);
      }
    });

    src.addEventListener("input", paint);
    nbBtn.addEventListener("click", () => setMode("notebook"));
    docBtn.addEventListener("click", () => setMode("doc"));
    window.addEventListener("resize", moveThumb);
    if (document.fonts?.ready) void document.fonts.ready.then(moveThumb);

    moveThumb();
    paint();
  }
</script>
