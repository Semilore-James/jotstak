---
// Live playground: type .jtr on the left, see it render on the right.
// Renders entirely client-side using the SAME @jotter/renderer the extension uses.
// No backend, no API call — this is the whole point of the local-first architecture.
const starter = "@decision title=\"Use Astro for the site\"\n  context: local-first, content-heavy\n  choice: Astro on Cloudflare Pages\n  consequences: near-zero hosting cost";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jotter Playground</title>
  </head>
  <body>
    <main>
      <textarea id="src" spellcheck="false">{starter}</textarea>
      <div id="out"></div>
    </main>

    <script>
      import { render } from "@jotter/renderer";
      const src = document.getElementById("src");
      const out = document.getElementById("out");
      const paint = () => {
        const { html } = render(src.value, { mode: "notebook" });
        out.innerHTML = html;
      };
      src.addEventListener("input", paint);
      paint();
    </script>
  </body>
</html>
