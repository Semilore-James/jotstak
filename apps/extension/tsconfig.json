{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "types": [
      "node",
      "vscode"
    ]
  },
  "references": [
    {
      "path": "../../packages/renderer"
    },
    {
      "path": "../../packages/schema"
    }
  ],
  "include": [
    "src"
  ]
}
