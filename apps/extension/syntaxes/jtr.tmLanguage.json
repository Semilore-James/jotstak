{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Jotter",
  "scopeName": "source.jtr",
  "fileTypes": ["jtr"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#margin-note-shorthand" },
    { "include": "#heading-shorthand" },
    { "include": "#bullet-shorthand" },
    { "include": "#numbered-shorthand" },
    { "include": "#divider-shorthand" },
    { "include": "#footnote-ref" },
    { "include": "#primitive-directive" },
    { "include": "#param-bracket" },
    { "include": "#string-double" },
    { "include": "#keyed-field" },
    { "include": "#inline-format" }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.jtr"
    },
    "margin-note-shorthand": {
      "match": "^(>>)(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.jtr" },
        "2": { "name": "string.unquoted.margin-note.jtr" }
      }
    },
    "heading-shorthand": {
      "match": "^(#{1,3})\\s+(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.heading.jtr" },
        "2": { "name": "markup.heading.jtr" }
      }
    },
    "bullet-shorthand": {
      "match": "^(\\s*)(-)\\s",
      "captures": {
        "2": { "name": "punctuation.definition.list.begin.jtr" }
      }
    },
    "numbered-shorthand": {
      "match": "^(\\s*)(\\d+\\.)\\s",
      "captures": {
        "2": { "name": "punctuation.definition.list.begin.jtr" }
      }
    },
    "divider-shorthand": {
      "match": "^---\\s*$",
      "name": "meta.separator.jtr"
    },
    "footnote-ref": {
      "match": "\\[\\^([a-zA-Z0-9_]+)\\]",
      "captures": {
        "1": { "name": "entity.name.tag.footnote.jtr" }
      }
    },
    "primitive-directive": {
      "comment": "All @-prefixed shortcodes. Scoped by semantic group for theming.",
      "patterns": [
        {
          "comment": "PM-artifact & diagram directives — terracotta (#c67139)",
          "match": "(@)(project|pillar|decision|evidence|metric|persona|sprint|risk|assumption|star_model|journey|matrix|timeline|doodle|banner|cover|spread|icon|export|signature)",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.jtr" },
            "2": { "name": "keyword.control.directive.jtr" }
          }
        },
        {
          "comment": "Data & relationship primitives — slate blue (#436475)",
          "match": "(@)(tree|pillars|footnote)",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.jtr" },
            "2": { "name": "entity.name.type.data.jtr" }
          }
        },
        {
          "comment": "Structural primitives — neutral umber (#73685e)",
          "match": "(@)(heading|bullet|numbered|divider|table|callout|info|warn|tip|question|quote|sticky)",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.jtr" },
            "2": { "name": "storage.type.structural.jtr" }
          }
        },
        {
          "comment": "Margin / annotation — sepia (#8b634b)",
          "match": "(@)(note)",
          "captures": {
            "1": { "name": "punctuation.definition.keyword.jtr" },
            "2": { "name": "comment.block.annotation.jtr" }
          }
        }
      ]
    },
    "param-bracket": {
      "comment": "Bracketed params like [status:active, color:#c67139]",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.section.brackets.begin.jtr" } },
      "endCaptures": { "0": { "name": "punctuation.section.brackets.end.jtr" } },
      "patterns": [
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)(:)",
          "captures": {
            "1": { "name": "variable.parameter.jtr" },
            "2": { "name": "punctuation.separator.key-value.jtr" }
          }
        },
        { "include": "#string-double" }
      ]
    },
    "string-double": {
      "match": "\"[^\"]*\"",
      "name": "string.quoted.double.jtr"
    },
    "keyed-field": {
      "comment": "Body key:value lines like 'context: ...', 'goal: ...'",
      "match": "^(\\s+)([a-zA-Z_][a-zA-Z0-9_ ]*)(:)\\s",
      "captures": {
        "2": { "name": "variable.other.member.jtr" },
        "3": { "name": "punctuation.separator.key-value.jtr" }
      }
    },
    "inline-format": {
      "patterns": [
        { "match": "\\*\\*[^*]+\\*\\*", "name": "markup.bold.jtr" },
        { "match": "\\*[^*]+\\*", "name": "markup.italic.jtr" },
        { "match": "==[^=]+==" , "name": "markup.highlight.jtr" },
        { "match": "__[^_]+__", "name": "markup.underline.jtr" }
      ]
    }
  }
}
