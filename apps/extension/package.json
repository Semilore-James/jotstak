{
  "name": "@jotstak/extension",
  "displayName": "Jotstak",
  "version": "0.0.0",
  "description": "Write PM documents in .jot and render them as a warm, hand-kept notebook.",
  "publisher": "TBD",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Programming Languages", "Visualization", "Other"],
  "keywords": ["product management", "prd", "notebook", "markdown alternative", "spec"],
  "main": "./dist/extension.js",
  "activationEvents": ["onLanguage:jot"],
  "contributes": {
    "languages": [
      {
        "id": "jot",
        "aliases": ["Jotstak", "jot"],
        "extensions": [".jot"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jot",
        "scopeName": "source.jot",
        "path": "./syntaxes/jot.tmLanguage.json"
      }
    ],
    "commands": [
      { "command": "jotstak.openPreview", "title": "Jotstak: Open Preview" },
      { "command": "jotstak.toggleMode", "title": "Jotstak: Toggle Notebook / Doc Mode" },
      { "command": "jotstak.exportHtml", "title": "Jotstak: Export as HTML" },
      { "command": "jotstak.copyMarkdown", "title": "Jotstak: Copy as Markdown" },
      { "command": "jotstak.learnSyntax", "title": "Jotstak: Learn the Syntax" }
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "@jotstak/renderer": "*",
    "@jotstak/schema": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^0.9.0",
    "typescript": "^5.6.0"
  }
}
