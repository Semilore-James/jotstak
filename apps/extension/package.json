{
  "name": "jotstak",
  "displayName": "Jotstak",
  "version": "0.4.0",
  "description": "Prose, tables and diagrams in one plain-text file, rendered as a warm, hand-kept notebook. .jot is a superset of Markdown, so any .md file works unchanged.",
  "license": "MIT",
  "publisher": "semilore-james",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#C67139",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "product management",
    "prd",
    "notebook",
    "markdown alternative",
    "spec"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:jot",
    "workspaceContains:**/*.jot",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jot",
        "aliases": [
          "Jotstak",
          "jot"
        ],
        "extensions": [
          ".jot"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jot",
        "scopeName": "source.jot",
        "path": "./syntaxes/jot.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "jotstak.openPreview",
        "title": "Jotstak: Open Preview"
      },
      {
        "command": "jotstak.toggleMode",
        "title": "Jotstak: Toggle Notebook / Doc Mode"
      },
      {
        "command": "jotstak.export",
        "title": "Jotstak: Export…"
      },
      {
        "command": "jotstak.exportHtml",
        "title": "Jotstak: Export as HTML"
      },
      {
        "command": "jotstak.learnSyntax",
        "title": "Jotstak: Learn the Syntax"
      },
      {
        "command": "jotstak.openWelcome",
        "title": "Jotstak: Open the Welcome Document"
      },
      {
        "command": "jotstak.indent",
        "title": "Jotstak: Indent Line and Children"
      },
      {
        "command": "jotstak.outdent",
        "title": "Jotstak: Outdent Line and Children"
      }
    ],
    "keybindings": [
      {
        "command": "jotstak.indent",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly && editorLangId == jot && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible && !editorTabMovesFocus && !editorHasMultipleSelections"
      },
      {
        "command": "jotstak.outdent",
        "key": "shift+tab",
        "when": "editorTextFocus && !editorReadonly && editorLangId == jot && !suggestWidgetVisible && !inSnippetMode && !editorTabMovesFocus && !editorHasMultipleSelections"
      }
    ],
    "walkthroughs": [
      {
        "id": "start",
        "title": "Get started with Jotstak",
        "description": "Write a document in plain text and watch it become a page.",
        "steps": [
          {
            "id": "welcome",
            "title": "Open the welcome document",
            "description": "Six short steps that teach by doing: change the text, watch the page follow. It opens as an unsaved copy, so it is yours to break.\n[Open the welcome document](command:jotstak.openWelcome)",
            "media": {
              "image": "media/walkthrough/page.png",
              "altText": "The welcome document rendered as a page of ruled notebook paper."
            },
            "completionEvents": [
              "onCommand:jotstak.openWelcome"
            ]
          },
          {
            "id": "preview",
            "title": "See it as a page",
            "description": "Open the preview beside any .jot file. It follows you as you type, as real A4 pages, and prints exactly as it shows.\n[Open the preview](command:jotstak.openPreview)",
            "media": {
              "image": "media/walkthrough/page.png",
              "altText": "A Jotstak page beside its source."
            },
            "completionEvents": [
              "onCommand:jotstak.openPreview"
            ]
          },
          {
            "id": "blocks",
            "title": "Add a block",
            "description": "Type @ at the start of a line to see every block and what it does. Pick one and it arrives ready to fill in: a decision, a risk, a tree, a timeline.\n[Show the blocks](command:editor.action.triggerSuggest)",
            "media": {
              "image": "media/walkthrough/blocks.png",
              "altText": "A decision card and a tree, each written in a few indented lines."
            },
            "completionEvents": [
              "onCommand:editor.action.triggerSuggest"
            ]
          },
          {
            "id": "looks",
            "title": "Notebook or doc",
            "description": "The same file in two looks: a warm, ruled notebook, or a clean white document.\n[Switch the look](command:jotstak.toggleMode)",
            "media": {
              "image": "media/walkthrough/looks.png",
              "altText": "The same card in notebook mode and in doc mode, side by side."
            },
            "completionEvents": [
              "onCommand:jotstak.toggleMode"
            ]
          },
          {
            "id": "share",
            "title": "Hand it on",
            "description": "Export a PDF, an HTML file that opens anywhere without the internet, or a copy to paste into an email or a wiki.\n[Export…](command:jotstak.export)",
            "media": {
              "markdown": "media/walkthrough/share.md"
            },
            "completionEvents": [
              "onCommand:jotstak.export"
            ]
          },
          {
            "id": "docs",
            "title": "Every block, with examples",
            "description": "The docs explain every block and every setting, with examples you can copy.\n[Open the docs](https://jotstak.pages.dev/docs/)",
            "media": {
              "markdown": "media/walkthrough/docs.md"
            },
            "completionEvents": [
              "onLink:https://jotstak.pages.dev/docs/"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "npm run build && vsce package --no-dependencies",
    "publish:vsce": "npm run build && vsce publish --no-dependencies",
    "publish:ovsx": "npm run build && ovsx publish --no-dependencies",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preflight": "node ../../scripts/preflight.mjs preflight.html"
  },
  "dependencies": {
    "@jotstak/renderer": "*",
    "@jotstak/schema": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "ovsx": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Semilore-James/jotstak.git",
    "directory": "apps/extension"
  }
}
