{
  "name": "@jotstak/extension",
  "displayName": "Jotstak",
  "version": "0.0.0",
  "description": "Prose, tables and diagrams in one plain-text file, rendered as a warm, hand-kept notebook. .jot is a superset of Markdown, so any .md file works unchanged.",
  "license": "MIT",
  "publisher": "semilore-james",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#C67139",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "product management",
    "prd",
    "notebook",
    "markdown alternative",
    "spec"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:jot"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jot",
        "aliases": [
          "Jotstak",
          "jot"
        ],
        "extensions": [
          ".jot"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jot",
        "scopeName": "source.jot",
        "path": "./syntaxes/jot.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "jotstak.openPreview",
        "title": "Jotstak: Open Preview"
      },
      {
        "command": "jotstak.toggleMode",
        "title": "Jotstak: Toggle Notebook / Doc Mode"
      },
      {
        "command": "jotstak.exportHtml",
        "title": "Jotstak: Export as HTML"
      },
      {
        "command": "jotstak.copyMarkdown",
        "title": "Jotstak: Copy as Markdown"
      },
      {
        "command": "jotstak.learnSyntax",
        "title": "Jotstak: Learn the Syntax"
      }
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "@jotstak/renderer": "*",
    "@jotstak/schema": "*"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Semilore-James/jotstak.git",
    "directory": "apps/extension"
  }
}
