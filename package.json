{
  "name": "jotstak",
  "version": "0.0.0",
  "private": true,
  "description": "A code-first document tool for product managers, rendered as a warm, hand-kept notebook.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w @jotstak/web",
    "dev:ext": "npm run watch -w @jotstak/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
