{
  "name": "jotter",
  "version": "0.0.0",
  "private": true,
  "description": "A code-first document tool for product managers, rendered as a warm, hand-kept notebook.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @jotter/web dev",
    "dev:ext": "pnpm --filter @jotter/extension watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20"
  }
}
